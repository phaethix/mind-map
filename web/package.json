{
  "name": "thoughts",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "serve": "vite",
    "build": "vite build && node ./scripts/copy.js",
    "lint": "eslint src --ext .js,.vue",
    "buildLibrary": "node ./scripts/updateVersion.js && vite build --mode library --name simpleMindMap ../simple-mind-map/full.js --dest ../simple-mind-map/dist && esbuild ../simple-mind-map/full.js --bundle --external:buffer --format=esm --outfile=../simple-mind-map/dist/simpleMindMap.esm.js && esbuild ../simple-mind-map/full.js --bundle --minify --external:buffer --format=esm --outfile=../simple-mind-map/dist/simpleMindMap.esm.min.js",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "createNodeImageList": "node ./scripts/createNodeImageList.js",
    "ai:serve": "node ./scripts/ai.js"
  },
  "dependencies": {
    "@toast-ui/editor": "^3.1.5",
    "axios": "^1.7.9",
    "codemirror": "^5.65.16",
    "element-plus": "^2.8.0",
    "highlight.js": "^10.7.3",
    "katex": "^0.19.0",
    "mermaid": "^10.9.3",
    "mitt": "^3.0.1",
    "pdf-lib": "^1.17.1",
    "simple-mind-map": "^0.14.0-fix.3",
    "simple-mind-map-plugin-themes": "^1.0.0",
    "uuid": "^11.0.0",
    "v-viewer": "^3.0.15",
    "vue": "^3.5.0",
    "vue-i18n": "^11.0.0",
    "vue-router": "^4.4.0",
    "vuex": "^4.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.32.0",
    "express": "^4.21.2",
    "less": "^4.2.0",
    "markdown-it": "^13.0.1",
    "markdown-it-checkbox": "^1.1.0",
    "prettier": "^3.9.10",
    "unplugin-vue-components": "^32.1.0",
    "vconsole": "^3.15.1",
    "vite": "^5.4.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "browser": true,
      "es2022": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "requireConfigFile": false,
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
