{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mind",
  "version": "0.1.3",
  "identifier": "com.huanyuli.mindmap",
  "build": {
    "frontendDist": "../../desktop-dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "node ensure-web.mjs",
    "beforeBuildCommand": "node prepare-dist.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mind",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "fileAssociations": [
      {
        "ext": ["xmind"],
        "name": "Mind",
        "mimeType": "application/vnd.xmind.xmind",
        "role": "Editor"
      },
      {
        "ext": ["smm"],
        "name": "Mind",
        "mimeType": "application/json",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/phaethix/mind-map/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4ODcyRjU3RTAyNjI1OUQKUldTZEpTYmdWeStIU0IyNW5QenJlY2RacXA4WnA0Nlh1YXIzSDlBaEk3OUJGczhSWHd0eWRTRHkK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
