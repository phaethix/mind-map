{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the mind map window",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://localhost:8080",
      "http://localhost:8080/*",
      "http://127.0.0.1:8080",
      "http://127.0.0.1:8080/*",
      "http://127.0.0.1:17321",
      "http://127.0.0.1:17321/*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-bootstrap",
    "allow-save-mind-map",
    "allow-save-config",
    "allow-save-lang",
    "allow-save-local-config",
    "allow-new-file",
    "allow-open-file",
    "allow-save-file-as",
    "allow-reveal-documents",
    "allow-take-pending-open",
    "allow-boot-log",
    "allow-list-files",
    "allow-library-list",
    "allow-library-create-folder",
    "allow-library-create-file",
    "allow-library-move",
    "allow-library-recent",
    "allow-library-search",
    "allow-library-rename-folder",
    "allow-library-delete-folder",
    "allow-open-path",
    "allow-rename-file",
    "allow-delete-file",
    "allow-save-thumbnail",
    "allow-ai-config-status",
    "allow-reveal-ai-config",
    "allow-ai-complete",
    "allow-github-status",
    "allow-github-auth-start",
    "allow-github-auth-poll",
    "allow-github-auth-cancel",
    "allow-github-sign-out",
    "allow-github-open-url",
    "allow-github-push",
    "allow-github-pull",
    "allow-github-list-gists",
    "allow-desktop-version",
    "allow-check-update",
    "allow-install-update",
    "allow-update-progress"
  ]
}
